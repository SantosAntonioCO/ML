## `train_ppo.py`
```python
"""
Treino PPO com arquivo de treino (train.csv). Salva modelo e plota reward, recall e FRR por episódio.
Uso:
    python train_ppo.py --train_csv train.csv --save_path models/ppo.pt

"""
import argparse
import os
import numpy as np
import torch
from ppo import PPOAgent
from gym_fraud_ppo.envs.gym_fraud_ppo import CreditCardFraudEnv
from utils import compute_returns, compute_advantages, recall_score, f1_score, accuracy_score, frr_score
import matplotlib.pyplot as plt

# pequenas compatibilidades
from sklearn.metrics import recall_score as _recall, f1_score as _f1, accuracy_score as _acc


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--train_csv', type=str, required=True)
    parser.add_argument('--save_path', type=str, default='models/ppo.pt')
    parser.add_argument('--num_episodes', type=int, default=200)
    parser.add_argument('--max_steps', type=int, default=None)
    args = parser.parse_args()

    env = CreditCardFraudEnv(csv_path=args.train_csv, max_steps=args.max_steps)
    obs_dim = env.data.shape[1]
    act_dim = 2

    agent = PPOAgent(obs_dim, act_dim)

    os.makedirs(os.path.dirname(args.save_path) or '.', exist_ok=True)

    rewards_history = []
    recall_history = []
    f1_history = []
    accuracy_history = []
    frr_history = []

    for ep in range(args.num_episodes):
        obs, _ = env.reset()
        done = False

        ep_rewards = []
        obs_batch = []
        actions = []
        log_probs_old = []
        values = []
        labels = []

        while not done:
            action, log_prob, value, _ = agent.select_action(obs)
            next_obs, reward, done, _, info = env.step(action)

            obs_batch.append(obs)
            actions.append(action)
            log_probs_old.append(log_prob.item())
            values.append(value.item())
            ep_rewards.append(reward)
            labels.append(info['label'])

            obs = next_obs

        returns = compute_returns(ep_rewards, gamma=agent.gamma)
        returns_t = returns
        values_arr = np.array(values, dtype=np.float32)
        advantages = compute_advantages(returns_t, values_arr)

        trajectories = {
            'obs': obs_batch,
            'actions': actions,
            'log_probs': log_probs_old,
            'returns': returns_t,
            'advantages': advantages
        }

        agent.update(trajectories)

        # metrics
        preds = actions
        recall = _recall(labels, preds, zero_division=0)
        f1 = _f1(labels, preds, zero_division=0)
        acc = _acc(labels, preds)
        # FRR
        from sklearn.metrics import confusion_matrix
        tn, fp, fn, tp = confusion_matrix(labels, preds, labels=[0,1]).ravel()
        frr = fn / (fn + tn) if (fn + tn) > 0 else 0.0

        total_reward = sum(ep_rewards)
        rewards_history.append(total_reward)
        recall_history.append(recall)
        f1_history.append(f1)
        accuracy_history.append(acc)
        frr_history.append(frr)

        print(f"Episode {ep+1}/{args.num_episodes} - Reward {total_reward:.2f} - Recall {recall:.3f} - F1 {f1:.3f} - FRR {frr:.3f}")

    # salvar modelo
    torch.save(agent.model.state_dict(), args.save_path)

    # plots
    plt.figure(figsize=(10,6))
    plt.plot(rewards_history, label='Reward')
    plt.plot(recall_history, label='Recall')
    plt.plot(frr_history, label='FRR')
    plt.legend()
    plt.xlabel('Episode')
    plt.title('Training curves')
    plt.grid(True)
    plt.savefig('training_curves.png')
    plt.show()
