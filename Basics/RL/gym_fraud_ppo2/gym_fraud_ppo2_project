## `ppo.py` (agente PPO — Actor-Critic, mínimo funcional)
```python
import torch
import torch.nn as nn
import torch.optim as optim
from torch.distributions import Categorical
import numpy as np

class ActorCritic(nn.Module):
    def __init__(self, obs_dim, act_dim, hidden_size=64):
        super().__init__()
        self.shared = nn.Sequential(
            nn.Linear(obs_dim, hidden_size),
            nn.ReLU()
        )
        self.policy_head = nn.Linear(hidden_size, act_dim)
        self.value_head = nn.Linear(hidden_size, 1)

    def forward(self, x):
        x = self.shared(x)
        logits = self.policy_head(x)
        probs = torch.softmax(logits, dim=-1)
        value = self.value_head(x)
        return probs, value.squeeze(-1)

class PPOAgent:
    def __init__(self, obs_dim, act_dim, lr=3e-4, gamma=0.99, eps_clip=0.2, K_epochs=4, vf_coef=0.5, ent_coef=0.01):
        self.model = ActorCritic(obs_dim, act_dim)
        self.optimizer = optim.Adam(self.model.parameters(), lr=lr)
        self.gamma = gamma
        self.eps_clip = eps_clip
        self.K_epochs = K_epochs
        self.vf_coef = vf_coef
        self.ent_coef = ent_coef

    def select_action(self, obs):
        obs_t = torch.tensor(obs, dtype=torch.float32)
        probs, value = self.model(obs_t)
        dist = Categorical(probs)
        action = dist.sample()
        return action.item(), dist.log_prob(action).detach(), value.detach(), dist.entropy().detach()

    def evaluate_actions(self, obs_batch, action_batch):
        probs, values = self.model(obs_batch)
        dist = Categorical(probs)
        log_probs = dist.log_prob(action_batch)
        entropy = dist.entropy()
        return log_probs, values, entropy

    def update(self, trajectories):
        # trajectories: dict with keys: obs, actions, log_probs_old, returns, advantages
        obs = torch.tensor(np.array(trajectories['obs']), dtype=torch.float32)
        actions = torch.tensor(trajectories['actions'], dtype=torch.int64)
        old_log_probs = torch.tensor(trajectories['log_probs'], dtype=torch.float32)
        returns = torch.tensor(trajectories['returns'], dtype=torch.float32)
        advantages = torch.tensor(trajectories['advantages'], dtype=torch.float32)

        for _ in range(self.K_epochs):
            log_probs, values, entropy = self.evaluate_actions(obs, actions)
            ratio = torch.exp(log_probs - old_log_probs)
            surr1 = ratio * advantages
            surr2 = torch.clamp(ratio, 1 - self.eps_clip, 1 + self.eps_clip) * advantages
            actor_loss = -torch.min(surr1, surr2).mean()

            critic_loss = nn.MSELoss()(values, returns)
            entropy_loss = entropy.mean()

            loss = actor_loss + self.vf_coef * critic_loss - self.ent_coef * entropy_loss

            self.optimizer.zero_grad()
            loss.backward()
            self.optimizer.step()
