## `gym_fraud_ppo/envs/gym_fraud_ppo.py`
```python
"""
Ambiente Gymnasium simples para detecção de fraude usando séries de transações.
Espera-se um CSV de treino com colunas: features... , Class (0/1)
O ambiente retorna observação (features normalizadas) e recompensa:
- +1 para detectar fraude corretamente (action=1 e label=1)
- -1 para falso negativo
- -0.1 para acerto negativo (evitar comportamento trivial)
- etc. Ajuste conforme necessário.

Compatível com Gymnasium API.
"""
import gymnasium as gym
from gymnasium import spaces
import numpy as np
import pandas as pd

class CreditCardFraudEnv(gym.Env):
    metadata = {"render.modes": ["human"]}

    def __init__(self, csv_path=None, max_steps=None, normalize=True):
        super().__init__()
        # csv_path: se None, usuário deve preencher env.data e env.labels manualmente
        self.csv_path = csv_path
        if csv_path is not None:
            self._load_csv(csv_path)

        self.current_step = 0
        self.normalize = normalize
        self.max_steps = max_steps

        # observation and action spaces set after load or user must set them
        if hasattr(self, 'data'):
            obs_dim = self.data.shape[1]
            self.observation_space = spaces.Box(low=-np.inf, high=np.inf, shape=(obs_dim,), dtype=np.float32)
            self.action_space = spaces.Discrete(2)  # 0 = non-fraud, 1 = fraud
        else:
            # defaults until data loaded
            self.observation_space = spaces.Box(low=-np.inf, high=np.inf, shape=(1,), dtype=np.float32)
            self.action_space = spaces.Discrete(2)

    def _load_csv(self, path):
        df = pd.read_csv(path)
        if 'Class' not in df.columns:
            raise ValueError("CSV must contain 'Class' column with 0/1 labels")
        labels = df['Class'].values.astype(int)
        features = df.drop(columns=['Class']).values.astype(np.float32)

        # simple standardization
        mean = features.mean(axis=0, keepdims=True)
        std = features.std(axis=0, keepdims=True) + 1e-8
        self.data = (features - mean) / std
        self.labels = labels

    def reset(self, seed=None, options=None):
        self.current_step = 0
        if self.max_steps is None:
            self.max_steps = len(self.data)
        obs = self.data[self.current_step]
        return obs, {}

    def step(self, action):
        label = int(self.labels[self.current_step])
        # reward design (tunable)
        if action == 1 and label == 1:
            reward = 1.0  # true positive
        elif action == 0 and label == 1:
            reward = -1.0  # false negative
        elif action == 1 and label == 0:
            reward = -0.5  # false positive
        else:
            reward = 0.1  # true negative (small positive to encourage correct non-fraud)

        self.current_step += 1
        done = self.current_step >= self.max_steps
        obs = self.data[self.current_step-1] if not done else np.zeros_like(self.data[0])
        info = {"label": label, "current_step": self.current_step}
        return obs, reward, done, False, info

    def seed(self, seed=None):
        np.random.seed(seed)

    def render(self, mode='human'):
        pass

    def close(self):
        pass
