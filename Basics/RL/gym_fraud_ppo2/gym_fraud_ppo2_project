"""
Avalia modelo treinado em `teste.csv`.
Uso:
    python test.py --model models/ppo.pt --test_csv teste.csv
"""
import argparse
import torch
import numpy as np
from gym_fraud_ppo.envs.gym_fraud_ppo import CreditCardFraudEnv
from ppo import PPOAgent, ActorCritic
from sklearn.metrics import recall_score, f1_score, accuracy_score, confusion_matrix

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--model', type=str, required=True)
    parser.add_argument('--test_csv', type=str, required=True)
    args = parser.parse_args()

    env = CreditCardFraudEnv(csv_path=args.test_csv)
    obs_dim = env.data.shape[1]
    act_dim = 2

    # carregar modelo
    model = ActorCritic(obs_dim, act_dim)
    model.load_state_dict(torch.load(args.model))
    model.eval()

    obs, _ = env.reset()
    done = False
    preds = []
    labels = []

    while not done:
        obs_t = torch.tensor(obs, dtype=torch.float32)
        probs, _ = model(obs_t)
        action = torch.argmax(probs).item()
        obs, _, done, _, info = env.step(action)
        preds.append(action)
        labels.append(info['label'])

    recall = recall_score(labels, preds, zero_division=0)
    f1 = f1_score(labels, preds, zero_division=0)
    acc = accuracy_score(labels, preds)
    tn, fp, fn, tp = confusion_matrix(labels, preds, labels=[0,1]).ravel()
    frr = fn / (fn + tn) if (fn + tn) > 0 else 0.0

    print(f"Test results — Recall: {recall:.4f}, F1: {f1:.4f}, Accuracy: {acc:.4f}, FRR: {frr:.4f}")
