import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import recall_score
import matplotlib.pyplot as plt
from gym_fraud_ppo.envs.gym_fraud_ppo import CreditCardFraudEnv
from ppo import PPO


def load_data(train_file="creditcard.csv"):
    df = pd.read_csv(train_file)
    X = df.drop("Class", axis=1).values
    y = df["Class"].values
    scaler = StandardScaler()
    X = scaler.fit_transform(X)
    return X, y, scaler


def evaluate_policy(env, policy, episodes=5):
    recalls = []
    frrs = []

    for _ in range(episodes):
        obs, _ = env.reset()
        done = False
        preds = []
        labels = []

        while not done:
            obs_t = torch.tensor(obs, dtype=torch.float32)
            action, _ = policy.act(obs_t)
            obs, reward, done, _, _ = env.step(action)
            preds.append(action)
            labels.append(env.labels[env.current_step - 1])

        labels = np.array(labels)
        preds = np.array(preds)
        recall = recall_score(labels, preds, zero_division=0)
        tn = np.sum((labels == 0) & (preds == 0))
        fn = np.sum((labels == 1) & (preds == 0))
        frr = fn / (fn + tn + 1e-9)

        recalls.append(recall)
        frrs.append(frr)

    return np.mean(recalls), np.mean(frrs)


def train_ppo(train_file="creditcard.csv", max_episodes=200):
    X, y, scaler = load_data(train_file)
    env = CreditCardFraudEnv(X, y)

    obs_dim = env.observation_space.shape[0]
    act_dim = env.action_space.n

    agent = PPO(obs_dim, act_dim)

    rewards_hist = []
    recall_hist = []
    frr_hist = []

    for ep in range(max_episodes):
        obs, _ = env.reset()
        done = False
        ep_reward = 0

        while not done:
            obs_t = torch.tensor(obs, dtype=torch.float32)
            action, logp = agent.policy.act(obs_t)
            obs, reward, done, _, _ = env.step(action)
            agent.buffer.store(obs_t, action, reward, logp)
            ep_reward += reward

        agent.update()

        recall, frr = evaluate_policy(env, agent.policy, episodes=3)

        rewards_hist.append(ep_reward)
        recall_hist.append(recall)
        frr_hist.append(frr)

        print(f"Episode {ep+1}/{max_episodes} | Reward={ep_reward:.1f} | Recall={recall:.3f} | FRR={frr:.3f}")

    # Plots
    plt.figure(figsize=(10, 6))
    plt.plot(rewards_hist, label="Reward")
    plt.plot(recall_hist, label="Recall")
    plt.plot(frr_hist, label="FRR")
    plt.legend()
    plt.xlabel("Episode")
    plt.ylabel("Metric Value")
    plt.title("PPO Training Metrics")
    plt.show()


if __name__ == "__main__":
    train_ppo()
