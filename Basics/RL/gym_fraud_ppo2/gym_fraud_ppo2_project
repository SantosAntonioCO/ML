## `utils.py`
```python
import numpy as np
from sklearn.metrics import recall_score, f1_score, accuracy_score, confusion_matrix


def compute_returns(rewards, gamma=0.99):
    R = 0
    returns = []
    for r in reversed(rewards):
        R = r + gamma * R
        returns.insert(0, R)
    return np.array(returns, dtype=np.float32)


def compute_advantages(returns, values):
    # generalized advantage baselines could be used; simple advantage = returns - values
    return returns - values


def frr_score(y_true, y_pred):
    # FRR = FN / (FN + TN)
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0,1]).ravel()
    denom = fn + tn
    return fn / denom if denom > 0 else 0.0
