# ================================
# 🔹 Imports
# ================================
import pennylane as qml
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.preprocessing import MinMaxScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix, f1_score, precision_score, recall_score, roc_auc_score, average_precision_score, accuracy_score
import pandas as pd
import numpy as np

# ================================
# 🔹 Configurações
# ================================
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
N_QUBITS = 8
N_LAYERS = 2
LR = 1e-3
BATCH_SIZE = 32
EPOCHS = 10

# ================================
# 🔹 Carregamento do dataset creditcard.csv
# ================================
df = pd.read_csv("../creditcard.csv")#pd.read_csv("creditcard.csv")

# Separar features e alvo
X = df.drop(columns=["Class"]).values
y = df["Class"].values

# Normalização para AngleEmbedding
scaler = MinMaxScaler(feature_range=(0, np.pi/2))
X_scaled = scaler.fit_transform(X)

# ================================
# 🔹 Criar treino e teste conforme pedido
# ================================
# indices de fraude e não fraude
idx_fraud = np.where(y==1)[0]
idx_nonfraud = np.where(y==0)[0]

# treino: 1000 não fraude + todas as fraudes menos 390
X_nonfraud_train = X_scaled[idx_nonfraud[:1000]]
y_nonfraud_train = y[idx_nonfraud[:1000]]

X_fraud_train = X_scaled[idx_fraud[:-390]]
y_fraud_train = y[idx_fraud[:-390]]

X_train = np.vstack([X_nonfraud_train, X_fraud_train])
y_train = np.hstack([y_nonfraud_train, y_fraud_train])

# teste: restante
X_nonfraud_test = X_scaled[idx_nonfraud[1000:]]
y_nonfraud_test = y[idx_nonfraud[1000:]]

X_fraud_test = X_scaled[idx_fraud[-390:]]
y_fraud_test = y[idx_fraud[-390:]]

X_test = np.vstack([X_nonfraud_test, X_fraud_test])
y_test = np.hstack([y_nonfraud_test, y_fraud_test])

# converter para tensores
X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)
y_train_t = torch.tensor(y_train, dtype=torch.float32).to(DEVICE)
X_test_t = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)
y_test_t = torch.tensor(y_test, dtype=torch.float32).to(DEVICE)

# ================================
# 🔹 Dispositivo e QNode
# ================================
dev = qml.device("default.qubit", wires=N_QUBITS)

def entangling_layer(wires):
    for i in range(len(wires)-1):
        qml.CNOT(wires=[wires[i], wires[i+1]])
    qml.CNOT(wires=[wires[-1], wires[0]])

@qml.qnode(dev, interface="torch", diff_method="backprop")
def quantum_circuit(x, thetas):
    qml.AngleEmbedding(x, wires=range(N_QUBITS))
    thetas = thetas.reshape(N_LAYERS, N_QUBITS)
    for l in range(N_LAYERS):
        for q in range(N_QUBITS):
            qml.RX(thetas[l,q], wires=q)
        entangling_layer(range(N_QUBITS))
    return [qml.expval(qml.PauliZ(i)) for i in range(N_QUBITS)]

# ================================
# 🔹 Modelo híbrido
# ================================
class HybridQMLP(nn.Module):
    def __init__(self, n_qubits, n_layers, n_features):
        super().__init__()
        self.fc_reduce = nn.Linear(n_features, n_qubits)
        self.q_weights = nn.Parameter(0.01 * torch.randn(n_layers * n_qubits))
        self.mlp = nn.Sequential(
            nn.Linear(n_qubits, 125),
            nn.ReLU(),
            nn.Linear(125, 1)
        )
    
    def forward(self, x_batch):
        x_red = self.fc_reduce(x_batch)
        expvals_list = [quantum_circuit(x_red[i], self.q_weights) for i in range(x_red.shape[0])]
        expvals = torch.stack([torch.tensor(ev, dtype=torch.float32, device=DEVICE) for ev in expvals_list])
        logits = self.mlp(expvals)
        return logits.squeeze(-1)

# ================================
# 🔹 Instanciação
# ================================
model = HybridQMLP(N_QUBITS, N_LAYERS, X.shape[1]).to(DEVICE)

# class_weight para BCE
n_nonfraud = y_train.sum() == 0
weight_pos = (y_train == 0).sum() / (y_train == 1).sum()
pos_weight = torch.tensor(weight_pos, dtype=torch.float32).to(DEVICE)
criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)

optimizer = optim.Adam(model.parameters(), lr=LR)

# ================================
# 🔹 Treino
# ================================
train_dataset = torch.utils.data.TensorDataset(X_train_t, y_train_t)
train_loader = torch.utils.data.DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True)

for epoch in range(EPOCHS):
    model.train()
    epoch_loss = 0
    for xb, yb in train_loader:
        optimizer.zero_grad()
        logits = model(xb)
        loss = criterion(logits, yb)
        loss.backward()
        optimizer.step()
        epoch_loss += loss.item()
    print(f"Epoch {epoch+1}/{EPOCHS}, Loss: {epoch_loss/len(train_loader):.4f}")

# ================================
#  Avaliação
# ================================
model.eval()
with torch.no_grad():
    logits = model(X_test_t)
    probs = torch.sigmoid(logits).cpu().numpy()
    y_pred = (probs >= 0.5).astype(int)

    f1 = f1_score(y_test, y_pred)
    recall = recall_score(y_test, y_pred)
    precision = precision_score(y_test, y_pred)
    accuracy = accuracy_score(y_test, y_pred)
    auc = roc_auc_score(y_test, probs)
    auc_pr = average_precision_score(y_test, probs)
    
    cm = confusion_matrix(y_test, y_pred)
    fn = cm[1,0]
    tp = cm[1,1]
    frr = fn / (tp + fn + 1e-9)

    print("\nClassification Report:\n", classification_report(y_test, y_pred, zero_division=0))
    print("\nConfusion Matrix:\n", cm)
    print(f"\nMetrics:\nF1-score: {f1:.4f}, Recall: {recall:.4f}, Precision: {precision:.4f}, Accuracy: {accuracy:.4f}, FRR: {frr:.4f}, AUC: {auc:.4f}, AUC-PR: {auc_pr:.4f}")
